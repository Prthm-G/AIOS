#!/usr/bin/env bash
set -uo pipefail

bridge_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
failed=0

check_command() {
  local command_name="$1"
  if command -v "$command_name" >/dev/null 2>&1; then
    printf '%-24s OK   %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf '%-24s FAIL missing\n' "$command_name"
    failed=1
  fi
}

check_path() {
  local label="$1"
  local target="$2"
  if [[ -e "$target" ]]; then
    printf '%-24s OK   %s\n' "$label" "$target"
  else
    printf '%-24s FAIL %s\n' "$label" "$target"
    failed=1
  fi
}

check_command claude
check_command codex
check_command git
check_command python3
check_command npx

check_path "AGENTS.md" "$bridge_root/AGENTS.md"
check_path "CLAUDE.md" "$bridge_root/CLAUDE.md"
check_path "Codex bridge skill" "$bridge_root/.agents/skills/codex-bridge/SKILL.md"
check_path "Claude bridge link" "$bridge_root/.claude/skills/codex-bridge"
check_path "SEO orchestrator" "$bridge_root/.agents/skills/skeure-seo-orchestrator/SKILL.md"
check_path "Skill router" "$bridge_root/bridge/SKILL-ROUTER.md"

printf '\nCodex authentication\n'
if ! codex login status; then
  failed=1
fi

printf '\nOpenSEO MCP status\n'
codex_mcp="$(codex mcp list 2>&1)"
printf '%s\n' "$codex_mcp"
if ! grep -q "openseo" <<<"$codex_mcp"; then
  failed=1
fi
if grep -q "openseo.*Not logged in" <<<"$codex_mcp"; then
  printf 'Codex OpenSEO requires OAuth authentication.\n'
  failed=1
fi

printf '\nClaude MCP status\n'
claude_mcp="$(claude mcp list 2>&1)"
printf '%s\n' "$claude_mcp"
if ! grep -q "openseo" <<<"$claude_mcp"; then
  failed=1
fi
if grep -q "openseo:.*Needs authentication" <<<"$claude_mcp"; then
  printf 'Claude OpenSEO requires OAuth authentication.\n'
  failed=1
fi

printf '\nProject skills\n'
(cd "$bridge_root" && npx --yes skills list --json) || failed=1

exit "$failed"
