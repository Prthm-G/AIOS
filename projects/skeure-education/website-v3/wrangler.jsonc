{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skeure-education-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },

  // PRODUCTION lead store. Same database the live Astro site writes to, so the
  // cutover does not split leads across two tables — the `leads` schema is
  // already applied there (db/leads.sql is a record of it, not a migration to
  // run). Without this binding the contact route accepts a submission and
  // silently drops it: see src/app/api/contact/route.ts (`persisted: false`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skeure-leads",
      "database_id": "a0ae43dd-59b1-4f6e-8ee6-3b6ef8bfad68"
    }
  ],

  // NOTE: the Turnstile *sitekey* is deliberately NOT a var here. Next inlines
  // NEXT_PUBLIC_* at build time, so a runtime Worker var never reaches the client
  // bundle — it would look configured and silently do nothing. The real sitekey
  // is the build-time default in src/components/contact/ContactForm.tsx; preview
  // builds override it via the environment. The matching TURNSTILE_SECRET *is* a
  // Worker secret (`wrangler secret put`), never a var and never in this file.

  // CUTOVER STEP — still commented. Attempted 2026-08-15 and rolled back.
  //
  // Two things must BOTH be true before uncommenting, and the second one bit us:
  //   1. The `skeure-education` Pages project must release education.skeure.com.
  //      (Works — needs Cloudflare Pages:Edit, which the deploy token has.)
  //   2. The zone's existing `CNAME education.skeure.com -> skeure-education.pages.dev`
  //      must be deleted, so wrangler can provision its own record and cert.
  //      Wrangler will NOT overwrite it: it fails with code 100117, "Hostname
  //      already has externally managed DNS records". This needs Zone:DNS:Edit on
  //      skeure.com, which the token does NOT currently have.
  //
  // Releasing the Pages domain without being able to delete the CNAME leaves the
  // hostname pointing at a project that no longer answers for it — a 522. Do not
  // start this sequence again until the token can do step 2.
  //
  // ROLLBACK (verified working, ~2 min): re-POST education.skeure.com to the
  // `skeure-education` Pages project domains endpoint. Cloudflare recreates the
  // CNAME itself. The Astro project and its deployment history are retained for
  // exactly this reason — do not delete that Pages project.
  // "routes": [{ "pattern": "education.skeure.com", "custom_domain": true }],

  // Bindings are NON-inheritable per environment, so anything the preview Worker
  // needs must be declared inside env.preview — nothing above leaks in.
  //
  // DB is deliberately left UNBOUND on preview: the contact route degrades to
  // { persisted: false } when env.DB is absent, so no preview submission can
  // ever reach the production `skeure-leads` D1. TURNSTILE_SECRET is supplied at
  // deploy time (use a Turnstile *test* secret for preview).
  "env": {
    "preview": {
      "name": "skeure-education-web-preview",
      "observability": {
        "enabled": true
      }
    }
  }
}
