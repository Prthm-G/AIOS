# Skeure Growth — variable NAMES only. Never commit a literal value.
# Copy to .env (gitignored) and fill in locally.

# Meta Ads CLI (`meta auth status`, `meta ads ...`)
# System-user token generated against the dedicated Skeure ads app.
ACCESS_TOKEN=
# The live ad account, act_ prefixed. Confirmed via `meta ads adaccount list`.
AD_ACCOUNT_ID=

# Recorded for reference by the setup docs; not read by the CLI.
META_APP_ID=
META_BUSINESS_ID=
META_PAGE_ID=
META_IG_BUSINESS_ID=
META_DATASET_ID=
