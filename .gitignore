.env
.env.local
.DS_Store
*.log
__pycache__/
node_modules/
.claude/settings.local.json
# Rooted deliberately. A bare `audits/` matched at any depth and silently
# swallowed projects/skeure-education/skeure-edu-seo/audits/ — three audit
# reports were lost to it on 2026-08-19. Keep the leading slash.
/audits/
website-build/
# ad-manager was archived to archives/ 2026-08-19 when it was folded into
# skeure-growth. It is its own nested git repo and carries a live Meta
# system-user token, so it stays out of this repo at the new path too.
archives/ad-manager-2026-08-19/

# manus is its own git repo (multi-tenant WhatsApp platform, node_modules +
# generated seed manifests would otherwise flood the AIOS root repo)
projects/manus/

# large local checkouts / tools, not AIOS content
codex-desktop-linux/
codex-headless/
claude-config/

# editor/sync-tool local state
.obsidian/
.stfolder/
.stignore

# real NBFC financial data (DB schema, Firebase config, source export) —
# never belongs in this public fork's history. Syncthing keeps this path
# populated locally; this entry is what actually keeps it out of git
# regardless of that, since a plain file move doesn't stick against sync.
projects/skeure-finance/

# daily-commit-and-push.sh's own log, never committed
.auto-commit.log
